--[[
    PulseUI
    Single-file Roblox UI library

    Designed for normal client-side Roblox UI use.

    Example:

    local UI = require(path.to.PulseUI)

    local Window = UI:CreateWindow({
        Title = "My Game",
        Subtitle = "v1.0",
        ToggleKey = Enum.KeyCode.RightShift
    })

    local Main = Window:CreateTab("Main", "◆")
    local Settings = Window:CreateTab("Settings", "⚙")

    Main:AddSection("General")

    Main:AddButton({
        Text = "Hello",
        Callback = function()
            print("Hello!")
        end
    })

    Main:AddToggle({
        Text = "Enabled",
        Flag = "Enabled",
        Default = true,
        Callback = function(Value)
            print(Value)
        end
    })
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

local PulseUI = {}
PulseUI.__index = PulseUI

PulseUI.Version = "2.0"

PulseUI.Theme = {
	Background = Color3.fromRGB(15, 15, 19),
	Background2 = Color3.fromRGB(20, 20, 26),
	Sidebar = Color3.fromRGB(18, 18, 24),

	Element = Color3.fromRGB(27, 27, 35),
	ElementHover = Color3.fromRGB(34, 34, 44),

	Accent = Color3.fromRGB(105, 90, 255),
	AccentDark = Color3.fromRGB(74, 62, 190),

	Text = Color3.fromRGB(244, 244, 248),
	SubText = Color3.fromRGB(150, 150, 166),

	Stroke = Color3.fromRGB(48, 48, 61),
	Danger = Color3.fromRGB(225, 72, 82)
}

local function New(ClassName, Properties)
	local Object = Instance.new(ClassName)

	for Property, Value in pairs(Properties or {}) do
		Object[Property] = Value
	end

	return Object
end

local function Corner(Object, Radius)
	return New("UICorner", {
		CornerRadius = UDim.new(0, Radius or 8),
		Parent = Object
	})
end

local function Stroke(Object, Color, Thickness, Transparency)
	return New("UIStroke", {
		Color = Color or PulseUI.Theme.Stroke,
		Thickness = Thickness or 1,
		Transparency = Transparency or 0.15,
		Parent = Object
	})
end

local function Tween(Object, Properties, Duration)
	local Animation = TweenService:Create(
		Object,
		TweenInfo.new(
			Duration or 0.18,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		Properties
	)

	Animation:Play()

	return Animation
end

local function SafeCallback(Callback, ...)
	if not Callback then
		return
	end

	local Args = table.pack(...)

	task.spawn(function()
		local Success, Error = pcall(function()
			Callback(table.unpack(Args, 1, Args.n))
		end)

		if not Success then
			warn("[PulseUI] Callback error:", Error)
		end
	end)
end

local function ClampNumber(Value, Minimum, Maximum)
	return math.clamp(tonumber(Value) or Minimum, Minimum, Maximum)
end

local function MakeDraggable(Frame, Handle)
	local Dragging = false
	local DragStart
	local StartPosition

	Handle.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 then
			Dragging = true
			DragStart = Input.Position
			StartPosition = Frame.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(Input)
		if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then
			local Delta = Input.Position - DragStart

			Frame.Position = UDim2.new(
				StartPosition.X.Scale,
				StartPosition.X.Offset + Delta.X,
				StartPosition.Y.Scale,
				StartPosition.Y.Offset + Delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 then
			Dragging = false
		end
	end)
end

local function SearchName(Object, Text)
	Object:SetAttribute("PulseSearch", string.lower(Text or ""))
end

local function CreateElement(Tab, Height, SearchText)
	local Holder = New("Frame", {
		Size = UDim2.new(1, 0, 0, Height),
		BackgroundColor3 = PulseUI.Theme.Element,
		BorderSizePixel = 0,
		Parent = Tab.Container
	})

	Corner(Holder, 8)
	Stroke(Holder)

	SearchName(Holder, SearchText)

	return Holder
end

