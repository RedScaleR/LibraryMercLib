			New("UIPadding", {
				PaddingLeft = UDim.new(0, 9),
				PaddingRight = UDim.new(0, 9),
				Parent = Box
			})

			local Control = {}

			function Control:Set(NewValue)
				Value = tostring(NewValue or "")
				Box.Text = Value

				if Flag then
					Window.Flags[Flag] = Value
				end

				SafeCallback(Options2.Callback, Value)
			end

			function Control:Get()
				return Value
			end

			Box.FocusLost:Connect(function(EnterPressed)
				Value = Box.Text

				if Flag then
					Window.Flags[Flag] = Value
				end

				SafeCallback(
					Options2.Callback,
					Value,
					EnterPressed
				)
			end)

			if Flag then
				Window.Flags[Flag] = Value
				Window.Controls[Flag] = Control
			end

			return Control
		end

		function Tab:AddDropdown(Options2)
			Options2 = Options2 or {}

			local Items = Options2.Values or {}
			local Value = Options2.Default or Items[1]
			local Flag = Options2.Flag
			local Open = false

			local VisibleItems = math.min(#Items, 5)
			local ExpandedHeight = 48 + (VisibleItems * 32) + 8

			local Holder = CreateElement(Tab, 48, Options2.Text)
			Holder.ClipsDescendants = true

			New("TextLabel", {
				Position = UDim2.fromOffset(13, 0),
				Size = UDim2.new(0.42, -13, 0, 48),
				BackgroundTransparency = 1,
				Text = Options2.Text or "Dropdown",
				TextColor3 = PulseUI.Theme.Text,
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Holder
			})

			local SelectButton = New("TextButton", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -10, 0, 8),
				Size = UDim2.new(0.55, 0, 0, 32),
				BackgroundColor3 = PulseUI.Theme.Background2,
				BorderSizePixel = 0,
				Text = tostring(Value or "Select"),
				TextColor3 = PulseUI.Theme.SubText,
				TextSize = 12,
				Font = Enum.Font.Gotham,
				AutoButtonColor = false,
				Parent = Holder
			})

			Corner(SelectButton, 7)
			Stroke(SelectButton)

			local OptionsFrame = New("ScrollingFrame", {
				Position = UDim2.fromOffset(10, 48),
				Size = UDim2.new(1, -20, 0, VisibleItems * 32),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 2,
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				CanvasSize = UDim2.new(),
				Parent = Holder
			})

			New("UIListLayout", {
				Padding = UDim.new(0, 4),
				Parent = OptionsFrame
			})

			local Control = {}

			local function RefreshButtons()
				for _, Child in ipairs(OptionsFrame:GetChildren()) do
					if Child:IsA("TextButton") then
						Child:Destroy()
					end
				end

				for _, Item in ipairs(Items) do
					local ItemButton = New("TextButton", {
						Size = UDim2.new(1, -4, 0, 28),
						BackgroundColor3 = PulseUI.Theme.Background2,
						BorderSizePixel = 0,
						Text = tostring(Item),
						TextColor3 = PulseUI.Theme.Text,
						TextSize = 12,
						Font = Enum.Font.Gotham,
						AutoButtonColor = false,
						Parent = OptionsFrame
					})

					Corner(ItemButton, 6)

					ItemButton.MouseButton1Click:Connect(function()
						Control:Set(Item)
						Open = false

						Tween(Holder, {
							Size = UDim2.new(1, 0, 0, 48)
						})
					end)
				end
			end

			function Control:Set(NewValue)
				Value = NewValue
				SelectButton.Text = tostring(Value)

				if Flag then
					Window.Flags[Flag] = Value
				end

				SafeCallback(Options2.Callback, Value)
			end

			function Control:Get()
				return Value
			end

			function Control:Refresh(NewItems)
				Items = NewItems or {}
				VisibleItems = math.min(#Items, 5)
				ExpandedHeight = 48 + (VisibleItems * 32) + 8

				OptionsFrame.Size = UDim2.new(
					1,
					-20,
					0,
					VisibleItems * 32
				)

				RefreshButtons()
			end

			SelectButton.MouseButton1Click:Connect(function()
				Open = not Open

				Tween(Holder, {
					Size = UDim2.new(
						1,
						0,
						0,
						Open and ExpandedHeight or 48
					)
				})
			end)

			RefreshButtons()

			if Flag then
				Window.Flags[Flag] = Value
				Window.Controls[Flag] = Control
			end

			return Control
		end

		function Tab:AddKeybind(Options2)
			Options2 = Options2 or {}

			local CurrentKey = Options2.Default or Enum.KeyCode.Unknown
			local Flag = Options2.Flag
			local Waiting = false

			local Holder = CreateElement(Tab, 48, Options2.Text)

			New("TextLabel", {
				Position = UDim2.fromOffset(13, 0),
				Size = UDim2.new(1, -115, 1, 0),
				BackgroundTransparency = 1,
				Text = Options2.Text or "Keybind",
				TextColor3 = PulseUI.Theme.Text,
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Holder
			})

			local KeyButton = New("TextButton", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(90, 30),
				BackgroundColor3 = PulseUI.Theme.Background2,
				BorderSizePixel = 0,
				Text = CurrentKey.Name,
				TextColor3 = PulseUI.Theme.SubText,
				TextSize = 11,
				Font = Enum.Font.GothamMedium,
				AutoButtonColor = false,
				Parent = Holder
			})

			Corner(KeyButton, 7)
			Stroke(KeyButton)

			local Control = {}

			function Control:Set(NewKey)
				if typeof(NewKey) ~= "EnumItem" then
					return
				end

				CurrentKey = NewKey
				KeyButton.Text = CurrentKey.Name

				if Flag then
					Window.Flags[Flag] = CurrentKey
				end
			end

			function Control:Get()
				return CurrentKey
			end

			KeyButton.MouseButton1Click:Connect(function()
				Waiting = true
				KeyButton.Text = "..."
			end)

			UserInputService.InputBegan:Connect(function(Input, GameProcessed)
				if Waiting then
					if Input.UserInputType == Enum.UserInputType.Keyboard then
						Waiting = false
						Control:Set(Input.KeyCode)
						SafeCallback(Options2.Changed, CurrentKey)
					end

					return
				end

				if not GameProcessed and Input.KeyCode == CurrentKey then
					SafeCallback(Options2.Callback)
				end
			end)

			if Flag then
				Window.Flags[Flag] = CurrentKey
				Window.Controls[Flag] = Control
			end

			return Control
		end

		function Tab:AddColorPicker(Options2)
			Options2 = Options2 or {}

			local Value = Options2.Default or Color3.fromRGB(255, 255, 255)
			local Flag = Options2.Flag

			local Holder = CreateElement(Tab, 76, Options2.Text)

			New("TextLabel", {
				Position = UDim2.fromOffset(13, 5),
				Size = UDim2.new(1, -65, 0, 24),
				BackgroundTransparency = 1,
				Text = Options2.Text or "Color",
				TextColor3 = PulseUI.Theme.Text,
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Holder
			})

			local Preview = New("Frame", {
				Position = UDim2.new(1, -42, 0, 9),
				Size = UDim2.fromOffset(28, 20),
				BackgroundColor3 = Value,
				BorderSizePixel = 0,
				Parent = Holder
			})

			Corner(Preview, 6)
			Stroke(Preview)

			local Boxes = {}

			local function MakeRGBBox(Name, X)
				local Box = New("TextBox", {
					Position = UDim2.new(X, 0, 0, 39),
					Size = UDim2.new(0.3, -6, 0, 27),
					BackgroundColor3 = PulseUI.Theme.Background2,
					BorderSizePixel = 0,
					Text = "0",
					TextColor3 = PulseUI.Theme.Text,
					TextSize = 11,
					Font = Enum.Font.Gotham,
					ClearTextOnFocus = false,
					Parent = Holder
				})

				Corner(Box, 6)
				Stroke(Box)

				Boxes[Name] = Box

				return Box
			end

			local R = MakeRGBBox("R", 0.025)
			local G = MakeRGBBox("G", 0.35)
			local B = MakeRGBBox("B", 0.675)

			local Control = {}

			local function RefreshText()
				R.Text = tostring(math.floor(Value.R * 255))
				G.Text = tostring(math.floor(Value.G * 255))
				B.Text = tostring(math.floor(Value.B * 255))
				Preview.BackgroundColor3 = Value
			end

			function Control:Set(NewValue)
				if typeof(NewValue) ~= "Color3" then
					return
				end

				Value = NewValue
				RefreshText()

				if Flag then
					Window.Flags[Flag] = Value
				end

				SafeCallback(Options2.Callback, Value)
			end

			function Control:Get()
				return Value
			end

			local function UpdateFromBoxes()
				Control:Set(Color3.fromRGB(
					ClampNumber(R.Text, 0, 255),
					ClampNumber(G.Text, 0, 255),
					ClampNumber(B.Text, 0, 255)
				))
			end

			R.FocusLost:Connect(UpdateFromBoxes)
			G.FocusLost:Connect(UpdateFromBoxes)
			B.FocusLost:Connect(UpdateFromBoxes)

			RefreshText()

			if Flag then
				Window.Flags[Flag] = Value
				Window.Controls[Flag] = Control
			end

			return Control
		end

		if #self.Tabs == 1 then
			self:SelectTab(Tab)
		end

		return Tab
	end

	SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		local Query = string.lower(SearchBox.Text)

		for _, Tab in ipairs(Window.Tabs) do
			for _, Object in ipairs(Tab.Container:GetChildren()) do
				if Object:IsA("GuiObject") then
					local Search = Object:GetAttribute("PulseSearch")

					if Search then
						Object.Visible =
							Query == ""
							or string.find(
								Search,
								Query,
								1,
								true
							) ~= nil
					end
				end
			end
		end
	end)

	local ToggleKey = Options.ToggleKey or Enum.KeyCode.RightShift

	UserInputService.InputBegan:Connect(function(Input, GameProcessed)
		if not GameProcessed and Input.KeyCode == ToggleKey then
			Window:Toggle()
		end
	end)

	return Window
end

return PulseUI
