	end)

	Close.MouseButton1Click:Connect(function()
		Window:Destroy()
	end)

	function Window:Toggle(State)
		if State == nil then
			self.Visible = not self.Visible
		else
			self.Visible = State
		end

		Main.Visible = self.Visible
		Shadow.Visible = self.Visible
	end

	function Window:Destroy()
		if ScreenGui then
			ScreenGui:Destroy()
		end
	end

	function Window:SetFlag(Flag, Value)
		self.Flags[Flag] = Value

		local Control = self.Controls[Flag]

		if Control and Control.Set then
			Control:Set(Value)
		end
	end

	function Window:GetFlag(Flag)
		return self.Flags[Flag]
	end

	function Window:ExportConfig()
		local Config = {}

		for Flag, Value in pairs(self.Flags) do
			if typeof(Value) == "Color3" then
				Config[Flag] = {
					__type = "Color3",
					R = math.floor(Value.R * 255),
					G = math.floor(Value.G * 255),
					B = math.floor(Value.B * 255)
				}
			elseif typeof(Value) == "EnumItem" then
				Config[Flag] = {
					__type = "KeyCode",
					Value = Value.Name
				}
			else
				Config[Flag] = Value
			end
		end

		return HttpService:JSONEncode(Config)
	end

	function Window:ImportConfig(Data)
		if type(Data) == "string" then
			local Success, Decoded = pcall(function()
				return HttpService:JSONDecode(Data)
			end)

			if not Success then
				warn("[PulseUI] Invalid config JSON.")
				return false
			end

			Data = Decoded
		end

		if type(Data) ~= "table" then
			return false
		end

		for Flag, Value in pairs(Data) do
			if type(Value) == "table" and Value.__type == "Color3" then
				Value = Color3.fromRGB(
					Value.R or 255,
					Value.G or 255,
					Value.B or 255
				)

			elseif type(Value) == "table" and Value.__type == "KeyCode" then
				Value = Enum.KeyCode[Value.Value]
			end

			self:SetFlag(Flag, Value)
		end

		return true
	end

	function Window:Notify(Options)
		Options = Options or {}

		local Existing = ScreenGui:FindFirstChild("Notifications")

		if not Existing then
			Existing = New("Frame", {
				Name = "Notifications",
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -18, 1, -18),
				Size = UDim2.fromOffset(320, 400),
				BackgroundTransparency = 1,
				Parent = ScreenGui
			})

			New("UIListLayout", {
				VerticalAlignment = Enum.VerticalAlignment.Bottom,
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				Padding = UDim.new(0, 8),
				Parent = Existing
			})
		end

		local Notification = New("Frame", {
			Size = UDim2.fromOffset(0, 74),
			BackgroundColor3 = PulseUI.Theme.Background2,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = Existing
		})

		Corner(Notification, 9)
		Stroke(Notification)

		New("Frame", {
			Size = UDim2.fromOffset(4, 74),
			BackgroundColor3 = PulseUI.Theme.Accent,
			BorderSizePixel = 0,
			Parent = Notification
		})

		New("TextLabel", {
			Position = UDim2.fromOffset(15, 10),
			Size = UDim2.new(1, -25, 0, 22),
			BackgroundTransparency = 1,
			Text = Options.Title or "Notification",
			TextColor3 = PulseUI.Theme.Text,
			TextSize = 14,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = Notification
		})

		New("TextLabel", {
			Position = UDim2.fromOffset(15, 32),
			Size = UDim2.new(1, -25, 0, 32),
			BackgroundTransparency = 1,
			Text = Options.Text or "",
			TextColor3 = PulseUI.Theme.SubText,
			TextSize = 12,
			TextWrapped = true,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = Notification
		})

		Tween(Notification, {
			Size = UDim2.fromOffset(300, 74)
		}, 0.25)

		task.delay(Options.Duration or 3, function()
			if Notification.Parent then
				Tween(Notification, {
					Size = UDim2.fromOffset(0, 74),
					BackgroundTransparency = 1
				}, 0.2)

				task.wait(0.22)

				if Notification.Parent then
					Notification:Destroy()
				end
			end
		end)
	end

	function Window:SelectTab(Tab)
		for _, OtherTab in ipairs(self.Tabs) do
			OtherTab.Container.Visible = false

			Tween(OtherTab.Button, {
				BackgroundColor3 = PulseUI.Theme.Sidebar,
				TextColor3 = PulseUI.Theme.SubText
			})
		end

		Tab.Container.Visible = true

		Tween(Tab.Button, {
			BackgroundColor3 = PulseUI.Theme.Accent,
			TextColor3 = Color3.new(1, 1, 1)
		})
	end

	function Window:CreateTab(Name, Icon)
		local Tab = {}

		local Button = New("TextButton", {
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = PulseUI.Theme.Sidebar,
			BorderSizePixel = 0,
			Text = (Icon and (Icon .. "   ") or "") .. (Name or "Tab"),
			TextColor3 = PulseUI.Theme.SubText,
			TextSize = 13,
			Font = Enum.Font.GothamMedium,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			Parent = TabButtons
		})

		Corner(Button, 7)

		New("UIPadding", {
			PaddingLeft = UDim.new(0, 12),
			Parent = Button
		})

		local Container = New("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = PulseUI.Theme.Accent,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			Visible = false,
			Parent = Content
		})

		New("UIPadding", {
			PaddingRight = UDim.new(0, 5),
			PaddingBottom = UDim.new(0, 8),
			Parent = Container
		})

		New("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = Container
		})

		Tab.Button = Button
		Tab.Container = Container

		table.insert(self.Tabs, Tab)

		Button.MouseButton1Click:Connect(function()
			self:SelectTab(Tab)
		end)

		Button.MouseEnter:Connect(function()
			if not Container.Visible then
				Tween(Button, {
					BackgroundColor3 = PulseUI.Theme.Element
				})
			end
		end)

		Button.MouseLeave:Connect(function()
			if not Container.Visible then
				Tween(Button, {
					BackgroundColor3 = PulseUI.Theme.Sidebar
				})
			end
		end)

		function Tab:AddSection(Text)
			local Section = New("TextLabel", {
				Size = UDim2.new(1, 0, 0, 26),
				BackgroundTransparency = 1,
				Text = string.upper(Text or "SECTION"),
				TextColor3 = PulseUI.Theme.SubText,
				TextSize = 10,
				Font = Enum.Font.GothamBold,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Container
			})

			SearchName(Section, Text)

			return Section
		end

		function Tab:AddDivider()
			return New("Frame", {
				Size = UDim2.new(1, 0, 0, 1),
				BackgroundColor3 = PulseUI.Theme.Stroke,
				BorderSizePixel = 0,
				Parent = Container
			})
		end

		function Tab:AddLabel(Text)
			local Holder = CreateElement(Tab, 38, Text)

			local Label = New("TextLabel", {
				Position = UDim2.fromOffset(13, 0),
				Size = UDim2.new(1, -26, 1, 0),
				BackgroundTransparency = 1,
				Text = Text or "Label",
				TextColor3 = PulseUI.Theme.SubText,
				TextSize = 13,
				TextWrapped = true,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Holder
			})

			return Label
		end

		function Tab:AddButton(Options2)
			Options2 = Options2 or {}

			local Holder = CreateElement(Tab, 44, Options2.Text)

			local Button2 = New("TextButton", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = Options2.Text or "Button",
				TextColor3 = PulseUI.Theme.Text,
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				AutoButtonColor = false,
				Parent = Holder
			})

			Button2.MouseEnter:Connect(function()
				Tween(Holder, {
					BackgroundColor3 = PulseUI.Theme.ElementHover
				})
			end)

			Button2.MouseLeave:Connect(function()
				Tween(Holder, {
					BackgroundColor3 = PulseUI.Theme.Element
				})
			end)

			Button2.MouseButton1Click:Connect(function()
				Tween(Holder, {
					BackgroundColor3 = PulseUI.Theme.Accent
				}, 0.08)

				task.delay(0.1, function()
					if Holder.Parent then
						Tween(Holder, {
							BackgroundColor3 = PulseUI.Theme.ElementHover
						})
					end
				end)

				SafeCallback(Options2.Callback)
			end)

			return Button2
		end

		function Tab:AddToggle(Options2)
			Options2 = Options2 or {}

			local State = Options2.Default == true
			local Flag = Options2.Flag

			local Holder = CreateElement(Tab, 48, Options2.Text)

			local Label = New("TextLabel", {
				Position = UDim2.fromOffset(13, 0),
				Size = UDim2.new(1, -75, 1, 0),
				BackgroundTransparency = 1,
				Text = Options2.Text or "Toggle",
				TextColor3 = PulseUI.Theme.Text,
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Holder
			})

			local Switch = New("Frame", {
				Size = UDim2.fromOffset(42, 22),
				Position = UDim2.new(1, -54, 0.5, -11),
				BackgroundColor3 = State
					and PulseUI.Theme.Accent
					or Color3.fromRGB(53, 53, 65),
				BorderSizePixel = 0,
				Parent = Holder
			})

			Corner(Switch, 20)

			local Circle = New("Frame", {
				Size = UDim2.fromOffset(16, 16),
				Position = State
					and UDim2.new(1, -19, 0.5, -8)
					or UDim2.new(0, 3, 0.5, -8),
				BackgroundColor3 = Color3.fromRGB(245, 245, 248),
				BorderSizePixel = 0,
				Parent = Switch
			})

			Corner(Circle, 20)

			local Control = {}

			function Control:Set(Value)
				State = Value == true

				if Flag then
					Window.Flags[Flag] = State
				end

				Tween(Switch, {
					BackgroundColor3 = State
						and PulseUI.Theme.Accent
						or Color3.fromRGB(53, 53, 65)
				})

				Tween(Circle, {
					Position = State
						and UDim2.new(1, -19, 0.5, -8)
						or UDim2.new(0, 3, 0.5, -8)
				})

				SafeCallback(Options2.Callback, State)
			end

			function Control:Get()
				return State
			end

			local Click = New("TextButton", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = "",
				Parent = Holder
			})

			Click.MouseButton1Click:Connect(function()
				Control:Set(not State)
			end)

			if Flag then
				Window.Flags[Flag] = State
				Window.Controls[Flag] = Control
			end

			return Control
		end

		function Tab:AddSlider(Options2)
			Options2 = Options2 or {}

			local Minimum = Options2.Min or 0
			local Maximum = Options2.Max or 100
			local Value = math.clamp(
				Options2.Default or Minimum,
				Minimum,
				Maximum
			)

			local Flag = Options2.Flag

			local Holder = CreateElement(Tab, 66, Options2.Text)

			New("TextLabel", {
				Position = UDim2.fromOffset(13, 4),
				Size = UDim2.new(1, -80, 0, 27),
				BackgroundTransparency = 1,
				Text = Options2.Text or "Slider",
				TextColor3 = PulseUI.Theme.Text,
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Holder
			})

			local ValueLabel = New("TextLabel", {
				Position = UDim2.new(1, -70, 0, 4),
				Size = UDim2.fromOffset(57, 27),
				BackgroundTransparency = 1,
				Text = tostring(Value),
				TextColor3 = PulseUI.Theme.SubText,
				TextSize = 12,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = Holder
			})

			local Track = New("Frame", {
				Position = UDim2.new(0, 13, 1, -20),
				Size = UDim2.new(1, -26, 0, 6),
				BackgroundColor3 = Color3.fromRGB(47, 47, 59),
				BorderSizePixel = 0,
				Parent = Holder
			})

			Corner(Track, 10)

			local Fill = New("Frame", {
				Size = UDim2.new(
					(Value - Minimum) / (Maximum - Minimum),
					0,
					1,
					0
				),
				BackgroundColor3 = PulseUI.Theme.Accent,
				BorderSizePixel = 0,
				Parent = Track
			})

			Corner(Fill, 10)

			local Dragging = false
			local Control = {}

			function Control:Set(NewValue)
				NewValue = ClampNumber(NewValue, Minimum, Maximum)

				if Options2.Round ~= false then
					NewValue = math.floor(NewValue + 0.5)
				end

				Value = NewValue

				if Flag then
					Window.Flags[Flag] = Value
				end

				local Percentage = (Value - Minimum) / (Maximum - Minimum)

				ValueLabel.Text = tostring(Value)

				Tween(Fill, {
					Size = UDim2.new(Percentage, 0, 1, 0)
				}, 0.08)

				SafeCallback(Options2.Callback, Value)
			end

			function Control:Get()
				return Value
			end

			local function SetFromPosition(X)
				local Percentage = math.clamp(
					(X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X,
					0,
					1
				)

				Control:Set(
					Minimum + ((Maximum - Minimum) * Percentage)
				)
			end

			Track.InputBegan:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseButton1 then
					Dragging = true
					SetFromPosition(Input.Position.X)
				end
			end)

			UserInputService.InputChanged:Connect(function(Input)
				if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then
					SetFromPosition(Input.Position.X)
				end
			end)

			UserInputService.InputEnded:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseButton1 then
					Dragging = false
				end
			end)

			if Flag then
				Window.Flags[Flag] = Value
				Window.Controls[Flag] = Control
			end

			return Control
		end

		function Tab:AddTextbox(Options2)
			Options2 = Options2 or {}

			local Value = Options2.Default or ""
			local Flag = Options2.Flag

			local Holder = CreateElement(Tab, 50, Options2.Text)

			New("TextLabel", {
				Position = UDim2.fromOffset(13, 0),
				Size = UDim2.new(0.42, -13, 1, 0),
				BackgroundTransparency = 1,
				Text = Options2.Text or "Textbox",
				TextColor3 = PulseUI.Theme.Text,
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Holder
			})

			local Box = New("TextBox", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.new(0.55, 0, 0, 32),
				BackgroundColor3 = PulseUI.Theme.Background2,
				BorderSizePixel = 0,
				Text = tostring(Value),
				PlaceholderText = Options2.Placeholder or "Enter text...",
				PlaceholderColor3 = PulseUI.Theme.SubText,
